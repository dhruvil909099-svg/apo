APP_NAME="Angel One SmartAPI Multi-Account IPO Dashboard"
APP_ENV="production"
DEBUG=false
TRADING_MODE="PAPER"
APP_ENCRYPTION_KEY="GENERATE_YOUR_OWN_FERNET_KEY_HERE"
MASTER_API_KEY="CHANGE_TO_A_SECURE_RANDOM_SECRET"
REQUIRE_AUTH=true
DATABASE_URL="sqlite:///./angel_dashboard.db"
ALLOWED_ORIGINS="http://localhost:5173,https://ipo.emperialcabs.com"
GLOBAL_MAX_ORDER_VALUE=500000.00
GLOBAL_MAX_QUANTITY_PER_ACCOUNT=5000
MAX_ORDERS_PER_BULK=50
RATE_LIMIT_ORDERS_PER_SEC=10
RATE_LIMIT_PORTFOLIO_PER_SEC=1
STATIC_IP_CHECK=false
